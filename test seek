--[[
    Seek Morph для Doors + Third Person Camera
    Управление:
      R — интро (вылезание из трубы)
      T — крик (Scream)
      L — переключение 1/3 лицо
--]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

if _G.SeekMorphActive then
    warn("[Seek Morph] Уже активен!")
    return
end
_G.SeekMorphActive = true

-- ============================================================
-- НАСТРОЙКА
-- ============================================================
local SEEK_ASSET = "rbxassetid://86341229891935"
local DOORS_TEST_PLACE_ID = 6627207668

-- Настройки камеры (как в Figure morph)
local isThirdPerson = true
local thirdPersonDistance = 12
local thirdPersonHeightOffset = 2

-- ============================================================
-- ЗАГРУЗКА МОДЕЛИ
-- ============================================================
local ok, figureNew = pcall(function()
    return game:GetObjects(SEEK_ASSET)[1]
end)

if not ok or not figureNew then
    warn("[Seek Morph] Не удалось загрузить модель Seek.")
    _G.SeekMorphActive = false
    return
end

local isTestPlace = (game.GameId == DOORS_TEST_PLACE_ID)
local canWalk = true
local introCD = false

figureNew.Parent = workspace

-- ============================================================
-- АНИМАЦИИ
-- ============================================================
local IntroAnim, PipeSlimeAnim, WalkAnim

if isTestPlace then
    figureNew.SeekMusic.Intro.SoundId = "rbxassetid://138877504428539"
    IntroAnim = figureNew.SeekRig.AnimationController.Animator:LoadAnimation(figureNew.AnimationsTest.minesintro)
    WalkAnim = figureNew.SeekRig.AnimationController.Animator:LoadAnimation(figureNew.AnimationsTest.run)
    PipeSlimeAnim = figureNew.FullPipe._SeekCutscene.AnimationController:LoadAnimation(figureNew.FullPipe._SeekCutscene.AnimationP)
else
    IntroAnim = figureNew.SeekRig.AnimationController.Animator:LoadAnimation(figureNew.Animations.minesintro)
    WalkAnim = figureNew.SeekRig.AnimationController.Animator:LoadAnimation(figureNew.Animations.run)
    PipeSlimeAnim = figureNew.FullPipe._SeekCutscene.AnimationController:LoadAnimation(figureNew.FullPipe._SeekCutscene.Animation)
end

WalkAnim:Play()
WalkAnim:AdjustSpeed(0)

-- ============================================================
-- ШАГИ
-- ============================================================
spawn(function()
    while figureNew.Parent do
        task.wait()
        if canWalk == false then
            figureNew.Figure.Footsteps:Stop()
            figureNew.Figure.FootstepsFar:Stop()
        end
        if figureNew.Figure.Footsteps.IsPlaying and not figureNew.Figure.FootstepsFar.IsPlaying then
            figureNew.Figure.FootstepsFar:Play()
        end
        if figureNew.Figure.FootstepsFar.IsPlaying and not figureNew.Figure.Footsteps.IsPlaying then
            figureNew.Figure.Footsteps:Play()
        end
    end
end)

-- ============================================================
-- АНИМАЦИЯ ПО СКОРОСТИ
-- ============================================================
spawn(function()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hum = char:WaitForChild("Humanoid")
    hum.Running:Connect(function(speed)
        if speed >= 5 then
            WalkAnim:AdjustSpeed(1)
            if canWalk and not figureNew.Figure.Footsteps.IsPlaying then
                figureNew.Figure.Footsteps:Play()
                figureNew.Figure.FootstepsFar:Play()
            end
        else
            WalkAnim:AdjustSpeed(0)
            if canWalk and figureNew.Figure.Footsteps.IsPlaying then
                figureNew.Figure.Footsteps:Stop()
                figureNew.Figure.FootstepsFar:Stop()
            end
        end
    end)
end)

-- ============================================================
-- ИНТРО (вылезание из трубы)
-- ============================================================
local function playIntro()
    if introCD then return end
    introCD = true
    canWalk = false

    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        introCD = false
        return
    end
    char.HumanoidRootPart.Anchored = true

    figureNew.FullPipe._SeekCutscene.SlimeDrip1.Transparency = 0
    figureNew.FullPipe._SeekCutscene.SlimeDrip2.Transparency = 0
    figureNew.FullPipe.GrateCap.Circle.Transparency = 0
    figureNew.FullPipe.GrateCap.Grate.Transparency = 0
    figureNew.FullPipe.FigurePipe.PipeBase.Transparency = 0
    figureNew.SeekRig.SeekPuddle.Transparency = 0

    spawn(function()
        task.wait(8.11)
        for _, Beam in pairs(figureNew.SeekRig:GetChildren()) do
            if Beam:IsA("Beam") and Beam.Name == "StringCheese" then
                Beam.Enabled = true
            end
        end
    end)
    spawn(function()
        task.wait(10.2)
        for _, Beam in pairs(figureNew.SeekRig:GetChildren()) do
            if Beam:IsA("Beam") and Beam.Name == "StringCheese" then
                Beam.Enabled = false
            end
        end
    end)

    IntroAnim:Play()
    PipeSlimeAnim:Play()
    figureNew.SeekMusic.Intro:Play()

    task.wait(IntroAnim.Length - 2)

    IntroAnim:Stop()
    figureNew.FullPipe._SeekCutscene.SlimeDrip1.Transparency = 1
    figureNew.FullPipe._SeekCutscene.SlimeDrip2.Transparency = 1
    figureNew.FullPipe.GrateCap.Circle.Transparency = 1
    figureNew.FullPipe.GrateCap.Grate.Transparency = 1
    figureNew.FullPipe.FigurePipe.PipeBase.Transparency = 1
    figureNew.SeekRig.SeekPuddle.Transparency = 1

    canWalk = true
    if char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.Anchored = false
    end
    introCD = false
end

-- ============================================================
-- СИНХРОНИЗАЦИЯ + СКРЫТИЕ + КАМЕРА 3-ГО ЛИЦА (как в Figure morph)
-- ============================================================
local renderConnection = RunService.RenderStepped:Connect(function()
    local character = LocalPlayer.Character
    if not character then return end

    -- Скрываем оригинального персонажа
    if character:FindFirstChild("Head") then
        character:FindFirstChild("Head").Transparency = 1
    end
    if character:FindFirstChild("Humanoid") then
        character:FindFirstChild("Humanoid").HipHeight = 2.3
    end

    -- Привязываем фигуру к HumanoidRootPart
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if hrp then
        figureNew:PivotTo(hrp.CFrame)
    end

    -- Скрываем части персонажа
    for _, v in pairs(character:GetChildren()) do
        if v:IsA("BasePart") then
            v.LocalTransparencyModifier = 1
            for _, dadada in pairs(v:GetDescendants()) do
                if dadada:IsA("Decal") or dadada:IsA("Texture") then
                    dadada.Transparency = 1
                end
            end
        elseif v:IsA("Accessory") then
            if v:FindFirstChild("Handle") then
                v.Handle.Transparency = 1
            end
        end
    end

    -- Камера от третьего лица
    local camera = workspace.CurrentCamera
    if camera and figureNew and figureNew.Parent then
        local morphHead = figureNew:FindFirstChild("Head", true)
        if not morphHead then
            morphHead = figureNew:FindFirstChildWhichIsA("BasePart")
        end

        if morphHead then
            if isThirdPerson then
                camera.CameraType = Enum.CameraType.Scriptable
                local lookVector = camera.CFrame.LookVector
                local upVector = camera.CFrame.UpVector
                local headPos = morphHead.Position
                local camPos = headPos - (lookVector * thirdPersonDistance) + Vector3.new(0, thirdPersonHeightOffset, 0)
                camera.CFrame = CFrame.lookAt(camPos, headPos, upVector)
            else
                camera.CameraType = Enum.CameraType.Custom
            end
        end
    end
end)

-- ============================================================
-- CLEANUP
-- ============================================================
_G.SeekMorphCleanup = function()
    if renderConnection then
        renderConnection:Disconnect()
        renderConnection = nil
    end

    local camera = workspace.CurrentCamera
    if camera then
        camera.CameraType = Enum.CameraType.Custom
    end

    if figureNew then
        figureNew:Destroy()
        figureNew = nil
    end

    _G.SeekMorphActive = false
    _G.SeekMorphCleanup = nil
end

-- ============================================================
-- УПРАВЛЕНИЕ
-- ============================================================
LocalPlayer:GetMouse().KeyDown:Connect(function(key)
    if key == "r" then
        playIntro()
    elseif key == "t" then
        figureNew.Figure.Scream:Play()
    elseif key == "l" then
        -- Переключение камеры от третьего лица
        isThirdPerson = not isThirdPerson
        if not isThirdPerson then
            local camera = workspace.CurrentCamera
            if camera then
                camera.CameraType = Enum.CameraType.Custom
            end
        end
        print("[Seek] Камера:", isThirdPerson and "3-е лицо" or "1-е лицо")
    end
end)

print("[Seek Morph] Загружен! R — интро, T — крик, L — камера")
