--[[
    Seek Morph (Third Person) для Doors
    Использование:
      - LocalScript в StarterPlayerScripts
      - Или через executor: loadstring(game:HttpGet("URL"))()
    
    Управление:
      R — интро (вылезание из трубы)
      T — крик (Scream)
      L — переключить 1-е / 3-е лицо
      B — удар при приземлении (заглушка)
--]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local StarterGui = game:GetService("StarterGui")

local player = Players.LocalPlayer

-- ============================================================
-- ЗАЩИТА ОТ ДВОЙНОГО ЗАПУСКА
-- ============================================================
if _G.SeekMorphCleanup then
    pcall(_G.SeekMorphCleanup)
end

-- ============================================================
-- НАСТРОЙКИ
-- ============================================================
local SEEK_ASSET       = 86341229891935
local DOORS_TEST_PLACE = 6627207668

local HEIGHT_OFFSET    = 2.5      -- подъём модели над HumanoidRootPart
local TP_DISTANCE      = 14       -- дистанция камеры в 3-м лице
local TP_HEIGHT_OFFSET = 3        -- высота камеры в 3-м лице
local FP_OFFSET        = Vector3.new(0, 0.2, -0.5)
local CAMERA_SMOOTH    = 0.25     -- сглаживание камеры (0 = мгновенно)

local isThirdPerson    = true     -- по умолчанию 3-е лицо

-- ============================================================
-- СОСТОЯНИЕ
-- ============================================================
local morph = nil
local morphRoot, morphHead = nil, nil
local rootWeld, headWeld = nil, nil

local originalChar, originalRoot, originalHumanoid, originalHead
local originalWalkSpeed, originalJumpPower, originalJumpHeight

local introAnim, walkAnim, pipeSlimeAnim
local canWalk = true
local introCD = false

local enforceConn, syncConn, moveConn, inputConn
local camera = workspace.CurrentCamera

local currentCamPos = nil
local currentCamLook = nil

-- ============================================================
-- УТИЛИТЫ
-- ============================================================
local function loadModel()
    local ok, obj = pcall(function()
        return game:GetObjects("rbxassetid://" .. SEEK_ASSET)[1]
    end)
    return ok and obj or nil
end

-- ============================================================
-- ОЧИСТКА
-- ============================================================
local function cleanupMorph()
    if enforceConn then enforceConn:Disconnect() enforceConn = nil end
    if syncConn then syncConn:Disconnect() syncConn = nil end
    if moveConn then moveConn:Disconnect() moveConn = nil end
    if inputConn then inputConn:Disconnect() inputConn = nil end

    if introAnim then introAnim:Stop() end
    if walkAnim then walkAnim:Stop() end
    if pipeSlimeAnim then pipeSlimeAnim:Stop() end

    if camera then
        camera.CameraType = Enum.CameraType.Custom
        camera.CameraSubject = originalHumanoid
    end

    if originalHumanoid then
        originalHumanoid.WalkSpeed = originalWalkSpeed or 16
        originalHumanoid.JumpPower = originalJumpPower or 50
        if originalJumpHeight then
            originalHumanoid.JumpHeight = originalJumpHeight
        end
    end

    if originalChar then
        for _, p in ipairs(originalChar:GetDescendants()) do
            if p:IsA("BasePart") then
                p.Transparency = 0
                p.CanCollide = true
                p.LocalTransparencyModifier = 0
            elseif p:IsA("Decal") or p:IsA("Texture") then
                p.Transparency = 0
            end
        end
    end

    if morph then morph:Destroy() morph = nil end

    _G.SeekMorphCleanup = nil
    _G.SeekMorphActive = false
end

_G.SeekMorphCleanup = cleanupMorph

-- ============================================================
-- ОСНОВНАЯ ФУНКЦИЯ
-- ============================================================
local function applyMorph()
    if _G.SeekMorphActive then return end
    _G.SeekMorphActive = true

    StarterGui:SetCore("SendNotification", {
        Title = "Seek Morph",
        Text = "3rd person enabled. L — toggle camera.",
        Duration = 4
    })

    -- Загрузка модели
    morph = loadModel()
    if not morph then
        warn("[Seek Morph] Не удалось загрузить модель.")
        _G.SeekMorphActive = false
        return
    end

    -- Оригинальный персонаж
    originalChar = player.Character or player.CharacterAdded:Wait()
    originalRoot = originalChar:WaitForChild("HumanoidRootPart")
    originalHumanoid = originalChar:WaitForChild("Humanoid")
    originalHead = originalChar:FindFirstChild("Head")

    originalWalkSpeed = originalHumanoid.WalkSpeed
    originalJumpPower = originalHumanoid.JumpPower
    originalJumpHeight = originalHumanoid.JumpHeight

    -- Убираем Humanaid у модели морфа
    local mHum = morph:FindFirstChildWhichIsA("Humanoid")
    if mHum then mHum:Destroy() end

    -- Отключаем физику всех частей
    for _, p in ipairs(morph:GetDescendants()) do
        if p:IsA("BasePart") then
            p.Anchored = false
            p.CanCollide = false
        end
    end

    -- RootPart модели
    morphRoot = morph:FindFirstChild("HumanoidRootPart", true)
        or morph:FindFirstChild("RootPart", true)
        or morph:FindFirstChild("Root", true)
    if not morphRoot then
        morphRoot = Instance.new("Part")
        morphRoot.Name = "HumanoidRootPart"
        morphRoot.Size = Vector3.new(2, 1, 1)
        morphRoot.CanCollide = false
        morphRoot.Parent = morph
    end
    morph.PrimaryPart = morphRoot

    -- Head модели (для камеры от 1-го лица)
    morphHead = morph:FindFirstChild("Head", true)
    if not morphHead then
        morphHead = morphRoot
    end

    morph.Parent = workspace

    -- Скрываем оригинального персонажа
    for _, p in ipairs(originalChar:GetDescendants()) do
        if p:IsA("BasePart") then
            p.Transparency = 1
            p.CanCollide = false
            p.LocalTransparencyModifier = 1
        elseif p:IsA("Decal") or p:IsA("Texture") then
            p.Transparency = 1
        end
    end
    if originalHead then originalHead.Transparency = 1 end

    -- Вэлд root
    rootWeld = Instance.new("Weld")
    rootWeld.Part0 = originalRoot
    rootWeld.Part1 = morphRoot
    rootWeld.C0 = CFrame.new(0, HEIGHT_OFFSET, 0)
    rootWeld.Parent = originalRoot

    -- Вэлд head (для 1-го лица)
    if originalHead and morphHead ~= morphRoot then
        headWeld = Instance.new("Weld")
        headWeld.Part0 = originalHead
        headWeld.Part1 = morphHead
        headWeld.C0 = CFrame.new(morphHead.Position - originalHead.Position)
        headWeld.Parent = originalHead
    end

    -- Камера
    if camera then
        camera.CameraType = Enum.CameraType.Scriptable
        camera.CameraSubject = nil
    end

    -- ========================================================
    -- АНИМАЦИИ
    -- ========================================================
    local isTestPlace = (game.GameId == DOORS_TEST_PLACE)

    if isTestPlace then
        morph.SeekMusic.Intro.SoundId = "rbxassetid://138877504428539"
        introAnim = morph.SeekRig.AnimationController.Animator:LoadAnimation(morph.AnimationsTest.minesintro)
        walkAnim  = morph.SeekRig.AnimationController.Animator:LoadAnimation(morph.AnimationsTest.run)
        pipeSlimeAnim = morph.FullPipe._SeekCutscene.AnimationController:LoadAnimation(morph.FullPipe._SeekCutscene.AnimationP)
    else
        introAnim = morph.SeekRig.AnimationController.Animator:LoadAnimation(morph.Animations.minesintro)
        walkAnim  = morph.SeekRig.AnimationController.Animator:LoadAnimation(morph.Animations.run)
        pipeSlimeAnim = morph.FullPipe._SeekCutscene.AnimationController:LoadAnimation(morph.FullPipe._SeekCutscene.Animation)
    end

    walkAnim:Play()
    walkAnim:AdjustSpeed(0)

    -- ========================================================
    -- ШАГИ
    -- ========================================================
    spawn(function()
        while morph and morph.Parent do
            task.wait()
            if not canWalk then
                morph.Figure.Footsteps:Stop()
                morph.Figure.FootstepsFar:Stop()
            end
            if morph.Figure.Footsteps.IsPlaying and not morph.Figure.FootstepsFar.IsPlaying then
                morph.Figure.FootstepsFar:Play()
            end
            if morph.Figure.FootstepsFar.IsPlaying and not morph.Figure.Footsteps.IsPlaying then
                morph.Figure.Footsteps:Play()
            end
        end
    end)

    -- ========================================================
    -- ИНТРО
    -- ========================================================
    local function playIntro()
        if introCD then return end
        introCD = true
        canWalk = false
        originalRoot.Anchored = true

        morph.FullPipe._SeekCutscene.SlimeDrip1.Transparency = 0
        morph.FullPipe._SeekCutscene.SlimeDrip2.Transparency = 0
        morph.FullPipe.GrateCap.Circle.Transparency = 0
        morph.FullPipe.GrateCap.Grate.Transparency = 0
        morph.FullPipe.FigurePipe.PipeBase.Transparency = 0
        morph.SeekRig.SeekPuddle.Transparency = 0

        spawn(function()
            task.wait(8.11)
            for _, b in pairs(morph.SeekRig:GetChildren()) do
                if b:IsA("Beam") and b.Name == "StringCheese" then b.Enabled = true end
            end
        end)
        spawn(function()
            task.wait(10.2)
            for _, b in pairs(morph.SeekRig:GetChildren()) do
                if b:IsA("Beam") and b.Name == "StringCheese" then b.Enabled = false end
            end
        end)

        introAnim:Play()
        pipeSlimeAnim:Play()
        morph.SeekMusic.Intro:Play()

        task.wait(introAnim.Length - 2)

        introAnim:Stop()
        morph.FullPipe._SeekCutscene.SlimeDrip1.Transparency = 1
        morph.FullPipe._SeekCutscene.SlimeDrip2.Transparency = 1
        morph.FullPipe.GrateCap.Circle.Transparency = 1
        morph.FullPipe.GrateCap.Grate.Transparency = 1
        morph.FullPipe.FigurePipe.PipeBase.Transparency = 1
        morph.SeekRig.SeekPuddle.Transparency = 1

        canWalk = true
        originalRoot.Anchored = false
        introCD = false
    end

    -- ========================================================
    -- СИНХРОНИЗАЦИЯ МОДЕЛИ С ИГРОКОМ
    -- ========================================================
    syncConn = RunService.RenderStepped:Connect(function()
        if not morph or not morph.Parent then return end
        if originalRoot then
            morph:PivotTo(originalRoot.CFrame * CFrame.new(0, HEIGHT_OFFSET, 0))
        end
    end)

    -- ========================================================
    -- АНИМАЦИЯ ХОДЬБЫ
    -- ========================================================
    originalHumanoid.Running:Connect(function(speed)
        if not morph or not morph.Parent then return end
        if speed >= 5 then
            walkAnim:AdjustSpeed(1)
            if canWalk and not morph.Figure.Footsteps.IsPlaying then
                morph.Figure.Footsteps:Play()
                morph.Figure.FootstepsFar:Play()
            end
        else
            walkAnim:AdjustSpeed(0)
            if canWalk and morph.Figure.Footsteps.IsPlaying then
                morph.Figure.Footsteps:Stop()
                morph.Figure.FootstepsFar:Stop()
            end
        end
    end)

    -- ========================================================
    -- КАМЕРА
    -- ========================================================
    enforceConn = RunService.RenderStepped:Connect(function(dt)
        if not camera then return end
        if not morph or not morph.Parent then return end

        local targetPos, targetLook

        if isThirdPerson then
            -- Третье лицо: камера сзади модели
            local headPos = (morphHead or morphRoot).Position
            local lookVec = originalRoot.CFrame.LookVector
            targetPos = headPos - lookVec * TP_DISTANCE + Vector3.new(0, TP_HEIGHT_OFFSET, 0)
            targetLook = headPos
        else
            -- Первое лицо
            local headPos = (morphHead or morphRoot).Position
            local lookVec = originalRoot.CFrame.LookVector
            targetPos = headPos + FP_OFFSET
            targetLook = targetPos + lookVec
        end

        -- Сглаживание
        if not currentCamPos then
            currentCamPos = targetPos
            currentCamLook = targetLook
        end
        currentCamPos = currentCamPos:Lerp(targetPos, math.clamp(CAMERA_SMOOTH, 0, 1))
        currentCamLook = currentCamLook:Lerp(targetLook, math.clamp(CAMERA_SMOOTH, 0, 1))

        camera.CFrame = CFrame.lookAt(currentCamPos, currentCamLook)
    end)

    -- ========================================================
    -- УПРАВЛЕНИЕ
    -- ========================================================
    inputConn = UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

        local key = input.KeyCode
        if key == Enum.KeyCode.R then
            playIntro()
        elseif key == Enum.KeyCode.T then
            morph.Figure.Scream:Play()
        elseif key == Enum.KeyCode.L then
            isThirdPerson = not isThirdPerson
        end
    end)

    print("[Seek Morph] Загружен! R — интро, T — крик, L — камера")
end

-- ============================================================
-- АВТО-ПЕРЕЗАПУСК ПРИ RESPAWN
-- ============================================================
player.CharacterAdded:Connect(function()
    task.wait(2)
    if not _G.SeekMorphActive then return end
    cleanupMorph()
    applyMorph()
end)

-- ============================================================
-- СТАРТ
-- ============================================================
applyMorph()
